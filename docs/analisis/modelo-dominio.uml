@startuml modelo-dominio
hide circle
hide empty members
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam linetype ortho
skinparam nodesep 110
skinparam ranksep 130
skinparam minClassWidth 140
skinparam class {
  BackgroundColor #D9D9D9
  BorderColor #707070
  FontColor #000000
  FontStyle bold
  FontSize 16
}
skinparam classBorderThickness 1
skinparam ArrowColor #404040
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 14
skinparam ArrowFontStyle bold

class Almacen
class Sector
class Cliente
class Pale
class Operario
class Movimiento

Almacen  -- Sector     : compone
Almacen  -- Cliente    : gestiona inventario de
Sector   -- Pale       : aloja
Pale     -- Movimiento : origina
Operario -- Movimiento : registra

@enduml
